{
  "name": "come-by-shop-backend",
  "version": "1.0.0",
  "description": "Come by Shop — backend API (Fastify + Drizzle + PostgreSQL)",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^11.2.1",
    "@t3-oss/env-core": "^0.13.11",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "google-auth-library": "^10.9.1",
    "nodemailer": "^10.0.16",
    "postgres": "^3.4.7",
    "resend": "^6.12.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.9"
  }
}
