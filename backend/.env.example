# .env.example — скопіюйте в .env і заповніть значення

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/come_by_shop

# Auth
JWT_SECRET=a66efc923704b2c2e5603f5e8f6f2f3e7bd373e931365bb6a112fa6b0a02e288

# CORS
ALLOWED_ORIGIN=http://localhost:3000

# TurboSMS
TURBOSMS_TOKEN=your_turbosms_api_token
TURBOSMS_SENDER=ComeByShop

# WayForPay
WAYFORPAY_MERCHANT_ACCOUNT=your_merchant_account
WAYFORPAY_SECRET_KEY=your_wayforpay_secret_key
WAYFORPAY_DOMAIN=come-by-shop.com

# Email (Resend)
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=re_your_resend_api_key
EMAIL_FROM_ADDRESS=no-reply@come-by-shop.com

# Email (Gmail SMTP для локального пет-проєкту)
# EMAIL_PROVIDER=smtp
# EMAIL_FROM_ADDRESS=your@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_16_digit_google_app_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Server
PORT=4000
